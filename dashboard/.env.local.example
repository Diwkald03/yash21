# Copy this file to ".env.local" and fill values.
# Everything here is SERVER-SIDE only — never shipped to the browser.

# ── Admin data viewer ────────────────────────────────────────────────────────
# Pick any secret. Then open http://localhost:3000/admin?key=YOUR_VALUE
ADMIN_KEY=

# ── Database: server-based Postgres (users, sessions, sources). ──────────────
# Easiest: run `npm run db` (starts a real local Postgres, no Docker) and use:
#   DATABASE_URL=postgresql://deodap:deodap@localhost:54329/deodap
# Or point at a cloud Postgres (Neon/Railway/Supabase) — set PGSSL=true there.
# Leave DATABASE_URL blank to fall back to the local JSON file store.
DATABASE_URL=
PGSSL=false

# ── Anthropic (live AI; without it, the local analyzer fallback is used) ──────
ANTHROPIC_API_KEY=
ANALYSIS_MODEL=claude-sonnet-4-6
BLOG_MODEL=claude-opus-4-8

# ── Gmail (password-reset emails). Without it, the reset code is shown in dev. ─
# Use a Gmail App Password: Google Account → Security → 2-Step Verification → App passwords
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ── Shopify (optional — only for the real "Publish to Shopify" step) ──────────
SHOPIFY_STORE_URL=https://grabnix.myshopify.com
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_BLOG_ID=

# ── Transcript engine override (optional; auto-detected otherwise) ────────────
# YTDLP_BIN=C:\path\to\yt-dlp.exe
# PYTHON_BIN=C:\path\to\python.exe
